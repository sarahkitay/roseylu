# Copy this file to .env and fill in real keys.
#
# These keys are used ONLY by the offline eval tooling in
# training/scripts/simulate_student_eval.py -- NEVER by the running app
# (backend/app/). That's a hard architectural rule in this repo, not a
# preference: see docs/ARCHITECTURE.md's "no third-party API in the live
# path" principle. This script simulates kid personas across grade levels
# and judges Rosey's responses to find gaps like the Columbus one that
# motivated building it -- it's a development tool, the same category as
# Claude authoring training/data/synthetic_dialogues.py or
# backend/app/knowledge/curated_qa.py by hand. Neither key is required for
# the app itself to run, build, or serve chat -- only for this specific
# script.
#
# Get keys at:
#   https://console.anthropic.com/settings/keys
#   https://platform.openai.com/api-keys

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
